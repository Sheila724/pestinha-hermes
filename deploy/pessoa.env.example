# Mais uma pessoa: copie para ~/.config/pestinha/<nome>.env (chmod 600). Nunca suba o arquivo real para o Git.
# <nome> é o mesmo do perfil do Hermes e da instância do systemd (ex.: pestinha2).

# Porta local desta ponte (a sua usa 8765; cada pessoa uma diferente). O Caddy aponta o endereço dela para cá.
PONTE_PORTA=8766

# Token que o pet DELA usa (diferente do seu). Gere com: openssl rand -hex 32
PONTE_TOKEN=

# API do perfil do Hermes DELA (API_SERVER_PORT e API_SERVER_KEY de ~/.hermes/profiles/<nome>/.env)
HERMES_URL=http://127.0.0.1:8643
HERMES_API_KEY=

# Banco só dela: fila, conversa, lembretes, cidade e diário
PONTE_BANCO=/home/sheila/.config/pestinha/pestinha2.db

# Como o pet chama a dona, e o jeito dele (arquivos em ponte/ponte/jeitos/: travesso, zoeiro)
PONTE_DONO=
PONTE_JEITO=zoeiro

HERMES_TIMEOUT=120
