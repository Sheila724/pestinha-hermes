# Copie para ~/.config/pestinha/ponte.env (chmod 600). Nunca suba o arquivo real para o Git.

# Token que o Pestinha usa (Authorization: Bearer ...). Gere com: openssl rand -hex 32
PONTE_TOKEN=

# API local do Hermes Agent e a chave dela (API_SERVER_KEY do ~/.hermes/.env)
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=

# Fila de eventos (SQLite).
PONTE_BANCO=/home/sheila/.config/pestinha/ponte.db

# Opcional: outra persona (padrão: ponte/ponte/persona.md)
# PONTE_PERSONA=/home/sheila/.config/pestinha/persona.md

# Segundos esperando o Hermes responder
HERMES_TIMEOUT=120
